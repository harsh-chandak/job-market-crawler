MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net"
DB_NAME=job_hunt
POLL_CONCURRENCY=12
POLL_TIMEOUT_MS=20000
TIER_S_MINUTES=3
TIER_A_MINUTES=15
TIER_B_MINUTES=60
TIER_C_MINUTES=360

# LLM — no key needed for the ollama or stub providers
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:3b
OLLAMA_NUM_CTX=8192
JD_CHARS=3000
# GROQ_API_KEY=gsk_REPLACE_ME
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Approve loop
@0000000:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=
